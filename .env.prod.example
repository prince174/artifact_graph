# Copy to .env.prod. Never commit the filled file.
# Generate TWO different passwords, for example: openssl rand -hex 32
# POSTGRES_PASSWORD must contain only A-Z, a-z, 0-9, underscore or dash (32+ chars).
POSTGRES_PASSWORD=
# Only for scripts/deploy.sh --prod-external-db. Percent-encode reserved characters
# in credentials and prefer sslmode=verify-full; sslmode=prefer permits plaintext fallback.
DATABASE_URL=
WEB_USERNAME=root
# local or ldap. WEB_PASSWORD remains the session signing secret in LDAP mode.
WEB_AUTH_PROVIDER=local
LDAP_URL=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_BASE_DN=
LDAP_USER_FILTER=(&(objectClass=user)(sAMAccountName={username}))
LDAP_CA_FILE=
LDAP_TIMEOUT_SECONDS=5
WEB_PASSWORD=

GRAPH_PORT=18080
# Used with compose.https.yaml. Directory contains fullchain.pem and privkey.pem.
HTTPS_CERT_DIR=./config/certs/https
HTTPS_BIND=0.0.0.0
HTTPS_PORT=443
BITBUCKET_PROVIDER=datacenter
# Base URLs only; keep the context path if your installation has one.
BITBUCKET_URL=https://bitbucket.company.example
BITBUCKET_TOKEN=
TEAMCITY_URL=https://teamcity.company.example
TEAMCITY_PUBLIC_URL=https://teamcity.company.example
TEAMCITY_TOKEN=
TEAMCITY_BUILD_LIMIT=0
TEAMCITY_BUILD_LOOKBACK_DAYS=90
TEAMCITY_INCREMENTAL_HISTORY=true
TEAMCITY_CONCURRENCY=4
BITBUCKET_CONCURRENCY=4

# Optional for Cloud; unused by the Data Center adapter.
BITBUCKET_WORKSPACE=
BITBUCKET_EMAIL=
BITBUCKET_AUTH=api_token

# Custom mapping file on the Linux host. Keep production rules outside the Git tree.
MAPPING_RULES_HOST_PATH=./config/mapping-rules.yaml

# Optional corporate CA bundle: mount a directory containing certificates, not private keys.
# Container path example: /app/certs/company-ca.pem
# Leave TLS_CA_FILE empty to use system trust roots.
LOG_LEVEL=DEBUG
TLS_CA_HOST_DIR=./config
TLS_CA_FILE=

WEB_SESSION_HOURS=12
WEB_LOGIN_ATTEMPTS=5
WEB_LOGIN_WINDOW_SECONDS=300
SCAN_HISTORY_LIMIT=100
INCREMENTAL_CACHE_SIZE=2000
PERSISTENT_CACHE_TTL_HOURS=168
PERSISTENT_CACHE_MAX_ROWS=5000
SNAPSHOT_HISTORY_LIMIT=50
API_RETRY_ATTEMPTS=4
API_RETRY_BACKOFF_SECONDS=0.5
WEBHOOK_ENABLED=false
WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_TIMEOUT_SECONDS=5
WEBHOOK_MAX_ATTEMPTS=6

# Data Center only: comma-separated project keys; empty means all accessible projects.
BITBUCKET_PROJECT_KEYS=

# TeamCity configuration IDs, comma-separated; empty means all accessible configurations.
TEAMCITY_BUILD_TYPE_IDS=
# Includes all descendant projects; explicit build type IDs take priority.
TEAMCITY_PROJECT_IDS=
