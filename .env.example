APP_MODE=demo
GRAPH_PORT=8080
DATABASE_URL=postgresql+psycopg://graph:graph@postgres:5432/graph
REFRESH_MINUTES=60
API_RETRY_ATTEMPTS=4
API_RETRY_BACKOFF_SECONDS=0.5
BITBUCKET_PROVIDER=cloud
BITBUCKET_WORKSPACE=your-workspace
BITBUCKET_EMAIL=reader@example.com
BITBUCKET_AUTH=api_token
BITBUCKET_TOKEN=replace-after-bootstrap
TEAMCITY_URL=http://teamcity:8111
TEAMCITY_PUBLIC_URL=http://localhost:8111
TEAMCITY_BOOTSTRAP_URL=http://localhost:8111
TEAMCITY_READER_USERNAME=artefact-graph-reader
TC_ADMIN_TOKEN=replace-for-bootstrap-only
TEAMCITY_TOKEN=replace-after-bootstrap
VERIFY_TLS=false
