APP_MODE=demo
GRAPH_PORT=8080
DATABASE_URL=postgresql+psycopg://graph:graph@postgres:5432/graph
REFRESH_MINUTES=60
SCAN_HISTORY_LIMIT=100
INCREMENTAL_CACHE_SIZE=2000
PERSISTENT_CACHE_TTL_HOURS=168
PERSISTENT_CACHE_MAX_ROWS=5000
SNAPSHOT_HISTORY_LIMIT=50
API_RETRY_ATTEMPTS=4
API_RETRY_BACKOFF_SECONDS=0.5
BITBUCKET_PROVIDER=cloud
BITBUCKET_WORKSPACE=your-workspace
BITBUCKET_EMAIL=reader@example.com
BITBUCKET_AUTH=api_token
BITBUCKET_TOKEN=replace-after-bootstrap
TEAMCITY_URL=http://teamcity:8111
TEAMCITY_PUBLIC_URL=http://localhost:8111
TEAMCITY_BOOTSTRAP_URL=http://localhost:8111
TEAMCITY_READER_USERNAME=artefact-graph-reader
TC_ADMIN_TOKEN=replace-for-bootstrap-only
TEAMCITY_TOKEN=replace-after-bootstrap
REGISTRY_ENABLED=true
REGISTRY_PROVIDER=docker
REGISTRY_URL=http://registry:5000
REGISTRY_PUBLIC_URL=http://localhost:5000
REGISTRY_USERNAME=
REGISTRY_TOKEN=
VERIFY_TLS=false
WEB_AUTH_ENABLED=true
WEB_USERNAME=root
WEB_PASSWORD=replace-with-a-long-random-password
WEB_SESSION_HOURS=12
WEB_COOKIE_SECURE=false
WEB_LOGIN_ATTEMPTS=5
WEB_LOGIN_WINDOW_SECONDS=300
MAPPING_RULES_PATH=/app/config/mapping-rules.yaml
WEBHOOK_ENABLED=false
WEBHOOK_URL=https://hooks.example.internal/artifact-graph
WEBHOOK_SECRET=replace-with-a-long-random-secret
WEBHOOK_VERIFY_TLS=true
WEBHOOK_ALLOW_HTTP=false
WEBHOOK_TIMEOUT_SECONDS=5
WEBHOOK_MAX_ATTEMPTS=6
